{
  "name": "majlis",
  "productName": "Majlis",
  "version": "0.6.1",
  "description": "Play with your friends over the internet. No accounts, just numbers.",
  "main": "src/main/main.js",
  "author": "ds1s1s1",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "fonts": "node scripts/copy-fonts.js",
    "dist": "npm run media && npm run core && npm run mpv && electron-builder --win portable nsis",
    "core": "node -e \"require('fs').mkdirSync('native',{recursive:true});require('fs').copyFileSync('../engine/target/release/majlis_core.dll','native/majlis-core.node')\"",
    "verify-release": "node scripts/check-release.js",
    "mpv": "node scripts/fetch-mpv.js",
    "media": "vite build --config media/vite.config.ts",
    "media:check": "tsc -p media/tsconfig.json",
    "prestart": "npm run media"
  },
  "dependencies": {
    "parse-torrent-title": "^3.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.1.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.8"
  },
  "build": {
    "appId": "app.majlis.desktop",
    "productName": "Majlis",
    "files": [
      "src/**/*",
      "native/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../engine/target/release",
        "to": "engine",
        "filter": [
          "majlis-engine.exe",
          "majlis-media.exe"
        ]
      },
      {
        "from": "../engine/vendor/mpv",
        "to": "mpv",
        "filter": [
          "mpv.exe",
          "d3dcompiler_43.dll",
          "mpv/fonts.conf",
          "LICENSE-mpv.txt"
        ]
      }
    ],
    "protocols": [
      {
        "name": "Majlis",
        "schemes": [
          "majlis"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "Majlis-portable.exe"
    },
    "nsis": {
      "artifactName": "Majlis-setup.exe",
      "oneClick": true
    },
    "asarUnpack": [
      "native/**/*"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeCliInspectArguments": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    }
  },
  "homepage": "https://github.com/ds1s1s1/majlis",
  "repository": {
    "type": "git",
    "url": "https://github.com/ds1s1s1/majlis.git"
  }
}
