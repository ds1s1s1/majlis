{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Majlis Setup",
  "version": "0.1.3-beta",
  "identifier": "app.majlis.setup",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Majlis Setup",
        "width": 940,
        "height": 640,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "center": true,
        "backgroundColor": "#12100E"
      }
    ],
    "security": {
      "csp": "default-src 'self' http://tauri.localhost; connect-src 'self' ipc: http://ipc.localhost http://tauri.localhost; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
